# Copy this file to .env and fill in the values before starting the server.
# All variables are optional with sensible defaults for local development.

# ---- Authentication --------------------------------------------------
# REQUIRED before exposing beyond localhost.
# Any long random string works. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset to run without auth (local dev only -- a warning will be logged).
API_KEY=

# ---- CORS -----------------------------------------------------------
# Comma-separated list of origins your frontend dashboard runs on.
# Defaults to localhost:3000 if not set.
# Example: ALLOWED_ORIGINS=https://dashboard.your-domain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ---- Rate limiting --------------------------------------------------
# Requests per window per client IP. Defaults: 60 requests / 60 seconds.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Logging --------------------------------------------------------
LOG_LEVEL=INFO

# ---- Server ---------------------------------------------------------
PORT=8000
